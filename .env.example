# The checked-in default is local and works without a network connection.
EXPO_PUBLIC_DATA_SOURCE=local

# Required only when EXPO_PUBLIC_DATA_SOURCE=supabase.
# These are public client values. Never put the service-role key in an Expo variable.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

