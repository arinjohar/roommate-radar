{
  "expo": {
    "name": "Roommate Radar",
    "slug": "roommate-radar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.roommateradar.app" },
    "android": {
      "package": "com.roommateradar.app",
      "adaptiveIcon": {
